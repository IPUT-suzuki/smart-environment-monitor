# Required TCP listener
SERVER_ADDR=0.0.0.0
SERVER_PORT=9000

# CSV storage
SENSOR_DATA_PATH=data/sensor_data.csv

# TCP behavior
TCP_ACCEPT_TIMEOUT_SECONDS=0.5
TCP_CONNECTION_TIMEOUT_SECONDS=10
TCP_MAX_REQUEST_BYTES=1048576
TCP_SHUTDOWN_TIMEOUT_SECONDS=2

# Cross-process CSV coordination (shared with web)
CSV_LOCK_TIMEOUT_SECONDS=5
CSV_LOCK_STALE_AFTER_SECONDS=60
